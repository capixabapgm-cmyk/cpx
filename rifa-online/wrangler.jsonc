{
  "name": "minhas-rifas-pedidos",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minhas-rifas",
      "database_id": "18c144e3-51db-4d09-8346-4a578e2d0a2e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "franciscoandrade.photo@gmail.com"
  }
}
